<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Full-page public calendar.
    Mounts the same website widget users can drag into pages via the
    Website Builder snippet — so this page gets the Previous / Today /
    Next month navigation for free, and defaults to the current month.

    An optional download-PDF link appears when a publication exists for
    the currently-viewed month. Because the widget navigates client-side,
    the button re-computes on each navigation via JS in website_calendar.js.
  -->
  <template id="public_calendar_page" name="Elks Calendar — Public Page">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <section class="s_elks_calendar container py-4">
          <h1 class="display-5 mb-3 text-center">Lodge Calendar</h1>
          <!--
            .elks-cal-mount is the class the JS widget hooks into. Empty
            data-year / data-month makes it default to the current month.
          -->
          <div class="elks-cal-mount"
               t-att-data-year="initial_year or ''"
               t-att-data-month="initial_month or ''"
               data-show-graphics="1">
            <p class="text-center text-muted">Loading calendar…</p>
          </div>
        </section>
      </div>
    </t>
  </template>

  <!-- Friendly empty state -->
  <template id="public_empty" name="Elks Calendar — Empty">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <section class="container py-5 text-center">
          <h2>The Lodge calendar hasn't been published yet</h2>
          <p class="lead text-muted">
            Check back soon, or follow Lewiston Elks Lodge #896 on Facebook
            for the latest updates.
          </p>
        </section>
      </div>
    </t>
  </template>

</odoo>
